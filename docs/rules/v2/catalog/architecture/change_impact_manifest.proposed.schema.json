{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splendor-os.org/schemas/change-impact-manifest.v1.json",
  "title": "Splendor Change Impact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "change_id", "base", "head", "changed_paths", "owners", "facets",
    "direct_packages", "transitive_packages", "components", "required_validation",
    "impact_cuts", "unresolved_edges"
  ],
  "properties": {
    "schema_version": {"const": "splendor.change_impact_manifest.v1"},
    "change_id": {"type": "string", "minLength": 1},
    "base": {"type": "string", "minLength": 1},
    "head": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owners": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "private_impl", "public_api", "wire_schema", "persistence", "event_semantics",
          "authority", "side_effect", "fabric", "agent_runtime", "data_feedback",
          "evaluation", "training", "change_deployment", "physical_safety",
          "generated_surface", "research_claim"
        ]
      }
    },
    "direct_packages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "transitive_packages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stable_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "persisted_objects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "driver_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts_and_lineage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_deployments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "physical_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "research_results_or_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_migrations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_validation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "impact_cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge", "reason", "evidence"],
        "properties": {
          "edge": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "unresolved_edges": {"type": "array", "items": {"type": "string"}}
  }
}
