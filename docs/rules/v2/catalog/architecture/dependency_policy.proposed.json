  "package_patterns": [
    {
      "pattern": "splendor-adapter-*",
      "role": "provider_driver",
      "tier": 10,
      "allowed_internal_dependencies": ["splendor-types", "splendor-gateway"],
      "allowed_internal_dev_dependencies": ["splendor-types", "splendor-gateway", "splendor-store"],
      "impact_facets": ["side_effect"],
      "forbidden_internal_dependencies": [
        "splendor-kernel", "splendor-daemon", "splendor-agent", "splendor-learning", "splendor-change"
      ]
    }
  ],
  "migration_exceptions": [
    {
      "source": "splendor-daemon",
      "targets": ["splendor-gateway", "splendor-store"],
      "scope": "Existing 0.1 daemon composition and handlers while application command/query facades are extracted.",
      "reason": "Current daemon directly composes gateway and stores.",
      "removal_condition": "Every endpoint calls a splendor-kernel application command/query and direct store/gateway imports disappear from handler modules.",
      "expires_by": "vNext application-service extraction",
      "allow_in_mode": ["migration"]
    },
    {
      "source": "splendorctl",
      "targets": ["splendor-gateway", "splendor-store", "splendor-adapter-filesystem", "splendor-adapter-http"],
      "scope": "Existing embedded-local CLI composition only.",
      "reason": "The current CLI constructs local adapters and stores for 0.1 workflows.",
      "removal_condition": "Local composition is isolated behind an embedded-local module and all ordinary commands use public application APIs.",
      "expires_by": "vNext CLI/application facade",
      "allow_in_mode": ["migration"]
    }
  ],
  "path_owners": [
    {"pattern": "crates/splendor-types/**", "owner": "splendor-types"},
    {"pattern": "crates/splendor-store/**", "owner": "splendor-store"},
    {"pattern": "crates/splendor-authority/**", "owner": "splendor-authority"},
    {"pattern": "crates/splendor-artifacts/**", "owner": "splendor-artifacts"},
    {"pattern": "crates/splendor-evidence/**", "owner": "splendor-evidence"},
    {"pattern": "crates/splendor-gateway/**", "owner": "splendor-gateway"},
    {"pattern": "crates/splendor-fabric/**", "owner": "splendor-fabric"},
    {"pattern": "crates/splendor-agent/**", "owner": "splendor-agent"},
    {"pattern": "crates/splendor-learning/**", "owner": "splendor-learning"},
    {"pattern": "crates/splendor-change/**", "owner": "splendor-change"},
    {"pattern": "crates/splendor-kernel/**", "owner": "splendor-kernel"},
    {"pattern": "crates/splendor-daemon/**", "owner": "splendor-daemon"},
    {"pattern": "crates/splendorctl/**", "owner": "splendorctl"},
    {"pattern": "adapters/**", "owner": "adapter"},
    {"pattern": "python/bindings/**", "owner": "splendor-bindings"},
    {"pattern": "python/splendor/**", "owner": "python-sdk"},
    {"pattern": "typescript/packages/types/**", "owner": "typescript-types"},
    {"pattern": "typescript/packages/client/**", "owner": "typescript-client"},
    {"pattern": "openapi/**", "owner": "splendor-daemon"},
    {"pattern": "conformance/**", "owner": "conformance"},
    {"pattern": "docs/spec/**", "owner": "architecture-api"},
    {"pattern": "examples/**", "owner": "examples"}
  ],
  "semantic_reverse_edges": {
