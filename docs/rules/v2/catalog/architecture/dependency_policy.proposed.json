    "splendor-store": ["splendor-authority", "splendor-artifacts", "splendor-evidence", "splendor-fabric", "splendor-agent", "splendor-learning", "splendor-change", "splendor-kernel", "splendor-daemon", "splendorctl"],
    "splendor-authority": ["splendor-artifacts", "splendor-evidence", "splendor-gateway", "splendor-fabric", "splendor-agent", "splendor-learning", "splendor-change", "splendor-kernel", "splendor-daemon", "splendor-node"],
